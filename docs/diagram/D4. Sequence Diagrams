@startuml
actor Tenant
participant "UI (Mobile App)" as UI
participant "Complaint Module" as Complaint
participant "Notification Module" as Notif

Tenant -> UI : Input judul, deskripsi kerusakan & foto
activate UI

Tenant -> UI : Klik "Kirim Keluhan"
UI -> Complaint : createComplaint(tenantId, roomNo, description, photo)
activate Complaint

alt Valid Input Data
    Complaint -> Complaint : Save Complaint (Status: Pending)
    Complaint -> Notif : sendNotificationToOwner(complaintId)
    activate Notif
    Notif --> Complaint : Notification Delivered
    deactivate Notif
    Complaint --> UI : Complaint Created Successfully
    UI --> Tenant : Tampilkan Status Tiket "Pending"
else Missing Description or Photo
    Complaint --> UI : Return Validation Error "Data belum lengkap"
    UI --> Tenant : Tampilkan Pesan Warning
end

deactivate Complaint
deactivate UI
@enduml
