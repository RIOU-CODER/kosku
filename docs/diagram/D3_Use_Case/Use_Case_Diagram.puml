@startuml
title D3 - Use Case Diagram Sistem Kosku
left to right direction
skinparam packageStyle rectangle
skinparam shadowing false
skinparam actorStyle hollow
skinparam usecase {
    BackgroundColor #FFFFFF
    BorderColor #333333
}
skinparam package {
    BackgroundColor #F7F7F7
    BorderColor #888888
}

' ===== Aktor (sesuai D1: Target Pengguna) =====
actor "Penyewa" as Penyewa
actor "Pemilik Kos" as Pemilik

rectangle "Sistem Kosku" {

    package "Modul Autentikasi" {
        usecase "UC-01: Login" as UC01
        usecase "UC-02: Logout" as UC02
    }

    package "Modul Manajemen Kamar" {
        usecase "UC-03: Kelola Data & Kapasitas Kamar" as UC03
        usecase "UC-04: Tempatkan Penyewa ke Kamar" as UC04
        usecase "UC-05: Perbarui Status Ketersediaan Kamar" as UC05
    }

    package "Modul Tagihan & Pembayaran" {
        usecase "UC-06: Terbitkan Tagihan Bulanan" as UC06
        usecase "UC-07: Lihat Tagihan Bulanan" as UC07
        usecase "UC-08: Bayar Tagihan" as UC08
        usecase "UC-09: Validasi Nominal Pembayaran" as UC09
        usecase "UC-10: Hitung Denda Keterlambatan" as UC10
        usecase "UC-11: Pantau Status Pembayaran" as UC11
    }

    package "Modul Tiket Keluhan" {
        usecase "UC-12: Buat Tiket Keluhan" as UC12
        usecase "UC-13: Validasi Nomor Kamar" as UC13
        usecase "UC-14: Lihat Status Tiket" as UC14
        usecase "UC-15: Perbarui Status Tiket" as UC15
        usecase "UC-16: Lacak Riwayat Kerusakan Kamar" as UC16
    }

    package "Modul Notifikasi" {
        usecase "UC-17: Kirim Notifikasi Tiket" as UC17
        usecase "UC-18: Kirim Pengingat Tagihan & Keterlambatan" as UC18
    }
}

' ===== Asosiasi: Penyewa =====
Penyewa -- UC01
Penyewa -- UC02
Penyewa -- UC07
Penyewa -- UC08
Penyewa -- UC12
Penyewa -- UC14
Penyewa -- UC18

' ===== Asosiasi: Pemilik Kos =====
UC01 -- Pemilik
UC02 -- Pemilik
UC03 -- Pemilik
UC04 -- Pemilik
UC06 -- Pemilik
UC11 -- Pemilik
UC15 -- Pemilik
UC16 -- Pemilik

' ===== Relasi <<include>> (wajib selalu dijalankan oleh use case dasar) =====
UC04 ..> UC05 : <<include>>
UC08 ..> UC09 : <<include>>
UC12 ..> UC13 : <<include>>
UC12 ..> UC17 : <<include>>
UC15 ..> UC17 : <<include>>

' ===== Relasi <<extend>> (opsional / bersyarat) =====
UC10 .> UC08 : <<extend>>\n[jika melewati\njatuh tempo]

note bottom of UC18
  Dipicu otomatis oleh sistem (modul Tagihan);
  Penyewa sebagai penerima pengingat.
end note
@enduml
